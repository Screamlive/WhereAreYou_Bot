# Single environment file for bot/webapp/ops services.
# Copy to /etc/telegram_bot/telegram_bot.env and set permissions:
# sudo install -m 600 -o <user> -g <user> deploy/env/telegram_bot.env.example /etc/telegram_bot/telegram_bot.env
#
# Это единственная точка хранения TOKEN.

# Required secret (do not commit real value):
TOKEN=PUT_YOUR_TOKEN_HERE

# Optional override. Keep in mind that DB_NAME is not fully centralized yet;
# safest path is to keep bot_database.db in config.py unless you deliberately
# align runtime and backup to another file:
# DB_NAME=/home/<user>/telegram_bot/bot_database.db
