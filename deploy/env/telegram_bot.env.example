# Single environment file for all bot services.
# Copy to /etc/telegram_bot/telegram_bot.env and set permissions:
# sudo install -m 600 -o <user> -g <user> deploy/env/telegram_bot.env.example /etc/telegram_bot/telegram_bot.env

# Required secret (do not commit real value):
TOKEN=PUT_YOUR_TOKEN_HERE

# Optional override (normally keep DB_NAME in local config.py):
# DB_NAME=/home/<user>/telegram_bot/bot_database.db
